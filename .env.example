# Copy this file to .env and fill in the values. .env is git-ignored.
#
# IMPORTANT: do NOT add ANTHROPIC_API_KEY here (or anywhere).
# Jarvis runs on the Claude Pro login used by Claude Code. If an API key
# is present, Claude Code bills that key instead of using the Pro subscription.

# Free image search API key (Phase 4c) — https://www.pexels.com/api/
PEXELS_API_KEY=

# Blender, for final 3D files (Phase 4d). This is the default location.
BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender

# How hard Claude thinks before answering: low | medium | high | xhigh | max.
# Higher = better on hard tasks but uses much more of the Pro usage limit.
JARVIS_EFFORT=medium

# claude.ai connectors to load: "all", or only some, e.g. "Gmail" or "Gmail, Canva".
# Every loaded connector adds its tool list (~9,000 tokens for all 8) to new conversations.
JARVIS_CONNECTORS=all

# Backend address. Must stay on 127.0.0.1 (this machine only).
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
